{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=HorizonHRMS;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Auth": {
    "Issuer": "HorizonHRMS",
    "Audience": "HorizonHRMS.Client",
    "SigningKey": "REPLACE_WITH_AT_LEAST_32_CHAR_SECRET",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Demo": {
    "SnapshotDate": "2026-10-30"
  },
  "Seed": {
    "Enabled": true,
    "UserPasswords": {}
  },
  "FileStorage": {
    "ReceiptsPath": "App_Data/receipts",
    "MaxReceiptBytes": 5242880
  },
  "AllowedHosts": "*"
}
