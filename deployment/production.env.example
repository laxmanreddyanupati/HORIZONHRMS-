# Supply backend values in Render's Environment settings, not in this repository.
ASPNETCORE_ENVIRONMENT=Production
Hosting__HttpsTerminatedAtProxy=true
ConnectionStrings__DefaultConnection=Server=tcp:YOUR-SERVER.database.windows.net,1433;Initial Catalog=HorizonHRMS;User ID=YOUR-SQL-USER;Password=YOUR-SQL-PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;
Auth__SigningKey=GENERATE-A-NEW-RANDOM-SECRET-AT-LEAST-32-CHARACTERS
Cors__AllowedOrigins__0=https://YOUR-PROJECT.pages.dev
Database__ApplyMigrations=true
Seed__Enabled=false
BootstrapAdmin__Enabled=true
BootstrapAdmin__Email=anupatilaxman2@gmail.com
BootstrapAdmin__Name=Laxman Reddy Anupati
BootstrapAdmin__Password=GENERATE-A-NEW-RANDOM-PASSWORD-AT-LEAST-16-CHARACTERS

# Set ONLY this public URL in Cloudflare Pages build environment variables.
VITE_API_BASE_URL=https://YOUR-API.onrender.com/api
